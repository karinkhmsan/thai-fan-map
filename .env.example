# ---------- ระบบล็อกอิน ----------
# ข้อความสุ่มยาวๆ ของตัวเอง ใช้เข้ารหัส session
JWT_SECRET=change-this-to-a-long-random-string

# ---------- ฐานข้อมูล (Postgres จริง เช่นจาก Supabase) ----------
# หาได้จาก Supabase: Project Settings > Database > Connection string
# DATABASE_URL = แบบ pooled (ผ่าน pgbouncer, พอร์ต 6543) ใช้ตอนแอปรันจริง
# DIRECT_URL   = แบบเชื่อมตรง (พอร์ต 5432) ใช้เฉพาะตอนรัน `npm run db:push`
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# ---------- ที่เก็บรูปภาพ (S3-compatible: Cloudflare R2 หรือ AWS S3) ----------
# ใช้ R2: ใส่ S3_ENDPOINT ด้วย, ใช้ AWS S3: เว้น S3_ENDPOINT ว่างแล้วตั้ง S3_REGION ให้ถูก
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=fanquestmap-uploads
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# โดเมนสาธารณะที่ใช้เปิดดูรูป (R2 public bucket URL หรือโดเมนของตัวเองที่ผูก CDN ไว้)
S3_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
