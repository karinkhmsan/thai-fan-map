// สคีมาฐานข้อมูลจริง ใช้กับ Postgres ใดก็ได้ (Supabase, Neon, RDS ฯลฯ)
// DATABASE_URL = connection string แบบ pooled (ผ่าน pgbouncer) ใช้ตอนแอปรันจริง
// DIRECT_URL   = connection string แบบตรง ใช้ตอนรัน migration/db push เท่านั้น
// Supabase ให้ทั้งสองค่านี้ในหน้า Project Settings > Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String?   @unique
  passwordHash String?
  avatarColor  String?
  avatarUrl    String?   // รูปโปรไฟล์ (URL จาก R2)
  bio          String?   // ประวัติส่วนตัว/คำอธิบาย
  facebookUrl  String?   // ลิงก์ Facebook
  instagramUrl String?   // ลิงก์ Instagram
  tiktokUrl    String?   // ลิงก์ TikTok
  role         String    @default("USER") // "USER" หรือ "ADMIN"
  isBanned     Boolean   @default(false)  // สถานะแบน (true = โดนแบน)
  createdAt    DateTime  @default(now())
  events       Event[]
  comments     Comment[]
  commentReports CommentReport[]
  donations    Donation[]
}

// รายการสนับสนุนเว็บ มาจาก 2 ทาง: Webhook จาก EasyDonate (ยืนยันแล้วอัตโนมัติ) หรือแนบสลิปเอง (รอแอดมินตรวจสอบ)
model Donation {
  id        String   @id @default(uuid())
  name      String   // ชื่อที่จะโชว์เป็นผู้สนับสนุน (โชว์ public ได้ถ้าอนุมัติแล้ว)
  amount    Int?     // จำนวนเงิน ใช้เช็คภายในเท่านั้น ไม่โชว์ public
  message   String?  // ข้อความจากผู้สนับสนุน (ถ้ามี เช่นจาก EasyDonate)
  slipUrl   String?  // รูปสลิปโอนเงิน (มีเฉพาะกรณีแนบสลิปเอง)
  source    String   @default("MANUAL") // "MANUAL" (แนบสลิปเอง) หรือ "EASYDONATE" (webhook)
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([status])
}

model Event {
  id          String    @id @default(uuid())
  title       String
  category    String
  province    String
  district    String    @default("")
  description String
  images      String[]  @default([])
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  comments    Comment[]

  @@index([province])
}

model Comment {
  id        String          @id @default(uuid())
  text      String
  eventId   String
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  reports   CommentReport[]
}

// รายงานความคิดเห็น: คนอื่น (ที่ไม่ใช่เจ้าของ) กดรายงานได้ ผู้ใช้คนหนึ่งรายงานคอมเมนต์เดิมซ้ำไม่ได้ (unique)
// แอดมินจะเห็นรายการนี้ในหน้า Admin แล้วลบคอมเมนต์ได้
model CommentReport {
  id         String   @id @default(uuid())
  commentId  String
  comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([commentId, reporterId])
}